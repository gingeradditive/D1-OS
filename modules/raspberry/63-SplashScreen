#!/bin/bash
set -xe
export LC_ALL=C

########################################
# Functions and Basic Configuration    #
########################################

source /common.sh
install_cleanup_trap

source /files/00-config   # deve definire BASE_USER

########################################
# Configuration                        #
########################################

DEPS="fbi"

BOOT_CONFIG="/boot/firmware/config.txt"
CMDLINE_CONFIG="/boot/cmdline.txt"

SPLASH_DIR="/usr/local/share/splash"
SPLASH_IMAGE_SRC="/home/${BASE_USER}/D1-Control/splash.png"
SPLASH_IMAGE_DST="${SPLASH_DIR}/splash.png"

SERVICE_FILE="/etc/systemd/system/splashscreen.service"

########################################
# Install dependencies                 #
########################################

apt-get update
apt-get install --yes ${DEPS}

########################################
# Install splash image                 #
########################################

echo "Installing splash image"

mkdir -p "${SPLASH_DIR}"
cp "${SPLASH_IMAGE_SRC}" "${SPLASH_IMAGE_DST}"
chmod 644 "${SPLASH_IMAGE_DST}"

########################################
# Boot configuration                   #
########################################

echo "Configuring boot options"

# disable firmware splash (idempotente)
grep -q "^disable_splash=1" "${BOOT_CONFIG}" || \
  echo "disable_splash=1" >> "${BOOT_CONFIG}"

# cmdline.txt: una sola riga!
if ! grep -q "logo.nologo" "${CMDLINE_CONFIG}"; then
  sed -i '1 s/$/ logo.nologo consoleblank=1 loglevel=0 quiet/' "${CMDLINE_CONFIG}"
fi

########################################
# Create systemd service               #
########################################

echo "Creating splashscreen service"

cat << 'EOF' > "${SERVICE_FILE}"
[Unit]
Description=Splash screen
DefaultDependencies=no
After=local-fs.target dev-fb0.device
Requires=dev-fb0.device
Before=graphical.target

[Service]
Type=simple
ExecStartPre=/usr/bin/sleep 3
ExecStart=/usr/bin/fbi -T 1 --noverbose -a --once /usr/local/share/splash/splash.png
StandardInput=tty-force
StandardOutput=tty
TTYPath=/dev/tty1

[Install]
WantedBy=sysinit.target
EOF

chmod 644 "${SERVICE_FILE}"

########################################
# Enable service                       #
########################################

systemctl daemon-reload
systemctl enable splashscreen.service

echo "Splashscreen service installed and enabled"

########################################
# Optional: test hint                  #
########################################

echo "You can test manually with:"
echo "  sudo fbi -T 1 -a ${SPLASH_IMAGE_DST}"